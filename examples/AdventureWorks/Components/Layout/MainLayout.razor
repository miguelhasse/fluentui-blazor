@inherits LayoutComponentBase

<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header">
        FluentUI AdventureWorks
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Content">
        <FluentMultiSplitter BarSize="6px" Orientation="Orientation.Horizontal">
            <FluentMultiSplitterPane Min="20%" Size="300px">
                <NavMenu />
            </FluentMultiSplitterPane>
            <FluentMultiSplitterPane Min="200px" Class="body-content">
                <div class="content">
                    <article id="article">
                        @Body
                    </article>
                </div>
            </FluentMultiSplitterPane>
        </FluentMultiSplitter>
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Footer" Style="height: 40px; color: white; font-size: var(--type-ramp-minus-1-font-size); line-height: var(--type-ramp-base-line-height);">
        <FluentStack>
        <div class="link1">
            <a href="https://www.fluentui-blazor.net" target="_blank">Documentation and demos</a>
        </div>
        <FluentSpacer />
        <div class="link2">
            <a href="https://learn.microsoft.com/en-us/aspnet/core/blazor" target="_blank">About Blazor</a>
        </div>
        </FluentStack>
    </FluentLayoutItem>
</FluentLayout>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
